{
  "name": "Whisper Transcriber Suite",
  "summary": "Free, offline desktop app that transcribes audio and video locally with OpenAI Whisper models.",
  "version": "v2.0.0",
  "released": "2026-10-10",
  "license": "BSD-3-Clause",
  "platforms": {
    "windows": "Installer and portable ZIP",
    "macos": "DMG",
    "linux": "Build from source"
  },
  "output_formats": [
    "srt", "vtt", "ass", "tsv", "txt", "json", "lrc", "md", "docx", "pdf",
    "otr", "elan", "inqscribe", "express_scribe"
  ],
  "engines": {
    "local": ["faster_whisper", "whisper_cpp", "nvidia_asr"],
    "cloud_opt_in": ["cloud_stt", "google_cloud_stt"]
  },
  "network": {
    "offline_after_model_download": true,
    "cloud_engines_default": "off",
    "account_required": false
  },
  "links": {
    "website": "https://whisper-transcriber-suite.pages.dev",
    "repository": "https://github.com/Milomilo777/whisper-transcriber-suite",
    "releases": "https://github.com/Milomilo777/whisper-transcriber-suite/releases",
    "issues": "https://github.com/Milomilo777/whisper-transcriber-suite/issues",
    "discussions": "https://github.com/Milomilo777/whisper-transcriber-suite/discussions",
    "llms_txt": "https://whisper-transcriber-suite.pages.dev/llms.txt",
    "llms_full_txt": "https://whisper-transcriber-suite.pages.dev/llms-full.txt",
    "comparison": "https://github.com/Milomilo777/whisper-transcriber-suite/blob/master/docs/COMPARISON.md",
    "server_api_docs": "https://github.com/Milomilo777/whisper-transcriber-suite/blob/master/docs/SERVER.md"
  }
}
